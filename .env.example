# Copy to apps/web/.env.local and fill in. Never commit real values.

# Neon Postgres (Singapore region). Use the pooled connection string.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/median?sslmode=require"

# Better Auth. Generate the secret with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google Gemini (free tier: TEST DATA ONLY, never real customer data).
GOOGLE_GENERATIVE_AI_API_KEY=""

# Razorpay (test mode keys for now).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Encrypts connector credentials (Razorpay tokens, API keys) at rest.
# 32 random bytes, base64: openssl rand -base64 32. Never reuse across environments.
CREDENTIALS_ENCRYPTION_KEY=""

# Protects /api/cron/sync (the daily scheduled sync). Vercel Cron sends it as
# "Authorization: Bearer <CRON_SECRET>". At least 16 characters; the route
# refuses every request without it. Generate: openssl rand -base64 32
CRON_SECRET=""

# Private Vercel Blob store for uploaded bills and statements. Create it with
# access PRIVATE (never public), ideally in Mumbai (bom1):
#   vercel blob create-store median-documents --access private --region bom1 --yes
# Files are only served through /api/documents/[id], which checks the session.
BLOB_READ_WRITE_TOKEN=
